    <script is:inline>
        (() => {
            const form = document.querySelector('[data-publish-form]');

            if (!(form instanceof HTMLFormElement)) {
                return;
            }

            const titleInput = form.elements.namedItem('title');
            const contentInput = form.elements.namedItem('content');
            const submitButton = form.querySelector('[data-submit-button]');
            const submitLabel = form.querySelector('[data-submit-label]');
            const loadingLabel = form.querySelector('[data-loading-label]');
            const loadingStatus = form.querySelector('[data-loading-status]');
            const publishedCard = document.querySelector('[data-published-card]');
            const publishedTitle = document.querySelector('[data-published-title]');
            const publishedContent = document.querySelector('[data-published-content]');
            const clearPublishedButton = document.querySelector('[data-clear-published]');

            if (
                !(titleInput instanceof HTMLInputElement) ||
                !(contentInput instanceof HTMLTextAreaElement) ||
                !(submitButton instanceof HTMLButtonElement) ||
                !(submitLabel instanceof HTMLElement) ||
                !(loadingLabel instanceof HTMLElement) ||
                !(loadingStatus instanceof HTMLElement) ||
                !(publishedCard instanceof HTMLElement) ||
                !(publishedTitle instanceof HTMLElement) ||
                !(publishedContent instanceof HTMLElement) ||
                !(clearPublishedButton instanceof HTMLButtonElement)
            ) {
                return;
            }

            const titleError = document.querySelector('#title-error');
            const contentError = document.querySelector('#content-error');

            if (
                !(titleError instanceof HTMLElement) ||
                !(contentError instanceof HTMLElement)
            ) {
                return;
            }

            const messages = {
                titleRequired: '请先写下文章标题。',
                titleMax: '文章标题不能超过 80 个字符。',
                contentRequired: '请写下文章内容。',
                contentMax: '文章内容不能超过 2000 个字符。',
            };

            const setLoading = (isLoading) => {
                form.setAttribute('aria-busy', String(isLoading));
                submitButton.disabled = isLoading;
                submitLabel.hidden = isLoading;
                loadingLabel.hidden = !isLoading;
                loadingStatus.hidden = !isLoading;
            };

            const clearFieldError = (input, error) => {
                input.setAttribute('aria-invalid', 'false');
                error.hidden = true;
                error.textContent = '';
            };

            const showFieldError = (input, error, message) => {
                input.setAttribute('aria-invalid', 'true');
                error.textContent = message;
                error.hidden = false;
            };

            const validate = () => {
                clearFieldError(titleInput, titleError);
                clearFieldError(contentInput, contentError);

                const title = titleInput.value.trim();
                const content = contentInput.value.trim();
                let firstInvalid = null;

                if (!title) {
                    showFieldError(titleInput, titleError, messages.titleRequired);
                    firstInvalid = titleInput;
                } else if (title.length > 80) {
                    showFieldError(titleInput, titleError, messages.titleMax);
                    firstInvalid = titleInput;
                }

                if (!content) {
                    showFieldError(contentInput, contentError, messages.contentRequired);
                    firstInvalid ??= contentInput;
                } else if (content.length > 2000) {
                    showFieldError(contentInput, contentError, messages.contentMax);
                    firstInvalid ??= contentInput;
                }

                if (firstInvalid) {
                    firstInvalid.focus();
                    return null;
                }

                return { title, content };
            };

            titleInput.addEventListener('input', () => clearFieldError(titleInput, titleError));
            contentInput.addEventListener('input', () => clearFieldError(contentInput, contentError));

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const article = validate();

                if (!article) {
                    return;
                }

                setLoading(true);
                loadingStatus.textContent = '正在浏览器本地校验并生成当前页面预览…';

                window.setTimeout(() => {
                    publishedTitle.textContent = article.title;
                    publishedContent.textContent = article.content;
                    form.reset();
                    clearFieldError(titleInput, titleError);
                    clearFieldError(contentInput, contentError);
                    publishedCard.hidden = false;
                    setLoading(false);
                    loadingStatus.textContent = '预览已生成，内容仅存在当前页面内存。';
                    loadingStatus.hidden = false;
                    publishedCard.focus();
                }, 420);
            });

            clearPublishedButton.addEventListener('click', () => {
                publishedCard.hidden = true;
                publishedTitle.textContent = '';
                publishedContent.textContent = '';
                form.reset();
                loadingStatus.textContent = '结果已清空，可以再写一篇。';
                loadingStatus.hidden = false;
                titleInput.focus();
            });
        })();
    </script>
</BaseLayout>
